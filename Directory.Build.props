<Project>

  <!--
    Strong naming.

    The key is deliberately committed: a strong name provides assembly identity,
    not security (the runtime does not validate the signature on .NET Core and
    later), so there is nothing secret to protect. Clast.snk is the same key file
    used across the clast-project repositories, so every EngineeredWood.* assembly
    carries the same public key token as every Clast.* dependency: 0b0eddb1936076d9.

    Signing is configured at the repository root rather than under src/ because a
    signed assembly may only name friends that are themselves signed. The test and
    benchmark projects appear in InternalsVisibleTo declarations throughout src/,
    so they have to be signed too.
  -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Clast.snk</AssemblyOriginatorKeyFile>

    <!--
      The full 2048-bit public key of Clast.snk. A signed assembly may only declare
      friends that specify a public key (CS1726), and the SDK does not append one
      by default. Setting PublicKey makes it stamp this key onto every
      InternalsVisibleTo item that does not carry its own Key metadata
      (Microsoft.NET.GenerateAssemblyInfo.targets), which keeps the ~60 declarations
      across src/ free of a 500-character literal.
    -->
    <PublicKey></PublicKey>
  </PropertyGroup>

</Project>
