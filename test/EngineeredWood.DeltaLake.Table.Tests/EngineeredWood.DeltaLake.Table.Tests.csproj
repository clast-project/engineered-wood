<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;net472</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- CodecSeamTests deliberately implements/exercises the experimental codec seam (EWDELTA0001). -->
    <NoWarn>$(NoWarn);EWDELTA0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Same mechanism the ORC and Avro cross-validation suites already use. xunit 2.x cannot skip
         from inside a test body — Assert.Skip is a v3 API and v2's Skip= is a compile-time constant —
         but the interop tiers decide at RUNTIME (is there a JDK? is deltalake installed?). See
         InteropDriver.Require. -->
    <PackageReference Include="Xunit.SkippableFact" />
    <!-- The CloudIO tests run the table layer against the emulators the cloud-io CI job starts. -->
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Clast.Google.Cloud.Storage.V1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EngineeredWood.DeltaLake\EngineeredWood.DeltaLake.csproj" />
    <ProjectReference Include="..\..\src\EngineeredWood.DeltaLake.Table\EngineeredWood.DeltaLake.Table.csproj" />
    <ProjectReference Include="..\..\src\EngineeredWood.Core\EngineeredWood.Core.csproj" />
    <ProjectReference Include="..\..\src\EngineeredWood.Expressions\EngineeredWood.Expressions.csproj" />
    <ProjectReference Include="..\..\src\EngineeredWood.Azure\EngineeredWood.Azure.csproj" />
    <ProjectReference Include="..\..\src\EngineeredWood.Aws\EngineeredWood.Aws.csproj" />
    <ProjectReference Include="..\..\src\EngineeredWood.Gcs\EngineeredWood.Gcs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The emulator availability gate, shared with the Parquet suite's cloud backend tests. -->
    <Compile Include="..\EngineeredWood.Parquet.Tests\IO\CloudEmulator.cs" Link="CloudIO\CloudEmulator.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TestData\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Interop\**\*.py" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shared with the Parquet suite's reader tiers; see test/Shared/InteropDriver.cs. -->
    <Compile Include="..\Shared\InteropDriver.cs" Link="Interop\InteropDriver.cs" />
  </ItemGroup>

</Project>
