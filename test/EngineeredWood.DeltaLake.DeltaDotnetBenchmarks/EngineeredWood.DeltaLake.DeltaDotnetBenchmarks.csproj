<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Head-to-head benchmarks: EngineeredWood.DeltaLake.Table against delta-dotnet (the
    DeltaLake.Net package, a P/Invoke wrapper over delta-rs + delta-kernel-rs).

    Deliberately NOT in engineered-wood.slnx: DeltaLake.Net is a ~220 MB package of native
    binaries, and nothing in the build or test gate needs it. Build and run this project
    directly; see README.md beside it.

    net10.0 only. DeltaLake.Net targets net8.0/net9.0/net472, and its native assets are
    resolved per RID (win-x64, linux-x64, linux-arm64, osx-x64, osx-arm64).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- DeltaLake.dll is not strong-named, and nothing names this assembly as a friend. -->
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EngineeredWood.DeltaLake\EngineeredWood.DeltaLake.csproj" />
    <ProjectReference Include="..\..\src\EngineeredWood.DeltaLake.Table\EngineeredWood.DeltaLake.Table.csproj" />
    <ProjectReference Include="..\..\src\EngineeredWood.Expressions\EngineeredWood.Expressions.csproj" />
    <ProjectReference Include="..\..\src\EngineeredWood.Expressions.Arrow\EngineeredWood.Expressions.Arrow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow" />
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="DeltaLake.Net" />
  </ItemGroup>

</Project>
