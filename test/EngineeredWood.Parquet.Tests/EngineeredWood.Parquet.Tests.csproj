<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;net472</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

  </PropertyGroup>

  <!-- ParquetSharp ships unsigned; strong-name it at build time so the net472 leg can bind
       it from this signed assembly. See build/StrongNameUnsignedReferences.targets. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\StrongNameUnsignedReferences.targets" />
  <ItemGroup>
    <UnsignedReferenceToSign Include="ParquetSharp" />
    <PackageReference Include="Mono.Cecil" PrivateAssets="all" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Clast.BloomFilter" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Clast.Google.Cloud.Storage.V1" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="ParquetSharp" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Runtime skips for the cloud-emulator tests (see IO/CloudEmulator.cs). xUnit 2.9.3 cannot skip
         from inside a test body — Assert.Skip is a v3 API — and whether an emulator is listening is
         only knowable at runtime. Same package and version the ORC, Avro and Delta suites use. -->
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The DuckDB / DataFusion reader tier. InteropDriver is shared with the Delta suite's tiers
         rather than copied; see test/Shared/InteropDriver.cs. -->
    <Compile Include="..\Shared\InteropDriver.cs" Link="Interop\InteropDriver.cs" />
    <None Update="Interop\**\*.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EngineeredWood.Parquet\EngineeredWood.Parquet.csproj" />
    <ProjectReference Include="..\..\src\EngineeredWood.Azure\EngineeredWood.Azure.csproj" />
    <ProjectReference Include="..\..\src\EngineeredWood.Gcs\EngineeredWood.Gcs.csproj" />
    <ProjectReference Include="..\..\src\EngineeredWood.Aws\EngineeredWood.Aws.csproj" />
    <ProjectReference Include="..\..\src\EngineeredWood.Expressions\EngineeredWood.Expressions.csproj" />
    <ProjectReference Include="..\..\src\EngineeredWood.Expressions.Arrow\EngineeredWood.Expressions.Arrow.csproj" />
  </ItemGroup>

</Project>
