<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(EwTestTargetFrameworks)</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- The interop tiers decide at RUNTIME whether their toolchain exists; see InteropDriver.Require. -->
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EngineeredWood.Core\EngineeredWood.Core.csproj" />
    <ProjectReference Include="..\..\src\EngineeredWood.Iceberg\EngineeredWood.Iceberg.csproj" />
    <ProjectReference Include="..\..\src\EngineeredWood.Expressions\EngineeredWood.Expressions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The iceberg-go driver's source travels to the test output and is built there on first use
         (Interop/IcebergGo.cs). -->
    <None Update="Interop\iceberg-go\*.go;Interop\iceberg-go\go.mod;Interop\iceberg-go\go.sum" CopyToOutputDirectory="PreserveNewest" />
    <!-- Committed oracle vectors, read from the test output. The corpus is read in place (Corpus/IcebergCorpus.cs):
         copied under bin/, its deepest paths pass Windows' 260-character limit. -->
    <None Include="TestData\**\*" Exclude="TestData\corpus\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shared with the Delta and Parquet suites' tiers; see test/Shared/InteropDriver.cs. -->
    <Compile Include="..\Shared\InteropDriver.cs" Link="Interop\InteropDriver.cs" />
  </ItemGroup>

</Project>
