<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net472</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      CS8002: ParquetSharp is not strongly named, and this assembly is (see the
      repository-root Directory.Build.props). It is a comparison baseline used only
      by the benchmarks and is never shipped, and .NET Core does not enforce
      strong-name references at run time, so the warning has nothing to say here.
    -->
    <NoWarn>$(NoWarn);CS8002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EngineeredWood.Parquet\EngineeredWood.Parquet.csproj" />
    <ProjectReference Include="..\..\src\EngineeredWood.Azure\EngineeredWood.Azure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow" Version="23.0.0" />
    <PackageReference Include="BenchmarkDotNet" Version="0.*" />
    <PackageReference Include="ParquetSharp" Version="23.*" />
    <PackageReference Include="PolySharp" Version="1.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <!-- Parquet.Net 5.6.0 dropped netstandard2.0; v6 dropped pre-.NET 8 entirely. -->
    <PackageReference Include="Parquet.Net" Version="5.5.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <PackageReference Include="Parquet.Net" Version="6.*" />
  </ItemGroup>

</Project>
