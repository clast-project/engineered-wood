<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;net472</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow" Version="23.0.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <!-- System.Text.Json ships in the shared framework from net8.0 on; net472 needs the package. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EngineeredWood.Vortex\EngineeredWood.Vortex.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TestData\**\*.vortex" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestData\upstream-compat\*.arrow" CopyToOutputDirectory="PreserveNewest" />
    <!-- The pins, not the fixtures: the tests enumerate their cases from this file. The
         downloaded fixtures stay out of the project; the tests read them in place. -->
    <None Remove="UpstreamCompat\fixtures\**" />
    <None Update="UpstreamCompat\fixtures.lock.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
