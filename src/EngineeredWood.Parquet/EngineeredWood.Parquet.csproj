<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PolySharpIncludeRuntimeSupportedAttributes>true</PolySharpIncludeRuntimeSupportedAttributes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EngineeredWood.Core\EngineeredWood.Core.csproj" />
    <ProjectReference Include="..\EngineeredWood.Expressions\EngineeredWood.Expressions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Clast.Alp" Version="0.2.0" />
    <PackageReference Include="Clast.BloomFilter" Version="0.2.0" />
    <PackageReference Include="Clast.Fsst" Version="0.3.1" />
    <PackageReference Include="System.IO.Hashing" Version="9.*" />
    <!--
      Shredded VARIANT reassembly. Apache.Arrow's VariantArray is storage-level: on a shredded
      column its `value` child is empty and the data lives in `typed_value`, so GetValueBytes
      returns zero bytes. Reassembly lives in this companion package (same version line; ships
      net462/netstandard2.0/net8.0, so it covers every TFM here). Used only by NestedAssembler,
      and only when the caller opts in via ParquetReadOptions.ExtensionRegistry.
    -->
    <PackageReference Include="Apache.Arrow.Operations" Version="23.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EngineeredWood.Parquet.Tests" />
    <InternalsVisibleTo Include="EngineeredWood.Parquet.Benchmarks" />
    <InternalsVisibleTo Include="EngineeredWood.Parquet.TestTool" />
    <InternalsVisibleTo Include="EngineeredWood.Tests" />
    <InternalsVisibleTo Include="EngineeredWood.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
