<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A Roslyn scan for spans read off Apache Arrow arrays after the array's last use (#834,
    doc/arrow-span-lifetime.md). Not part of engineered-wood.slnx, so CI never builds it; see README.md.
    The Directory.Build.props and Directory.Packages.props beside it keep the repository's build settings out.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>span-lifetime-scan</AssemblyName>
    <RootNamespace>SpanLifetimeScan</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

</Project>
